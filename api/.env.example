# Copy this file to api/.env and fill in real values. Never commit api/.env.

# --- Database (Neon) ---
# Locally, use the connection string of the Neon *dev* branch.
# The "+psycopg" part tells SQLAlchemy to use the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Ticketmaster Discovery API ---
# "Consumer Key" from https://developer.ticketmaster.com/ (My Apps)
TICKETMASTER_API_KEY=your-ticketmaster-consumer-key

# --- Shared secret between web (Next.js) and api ---
# Must be the same value in web/.env. Required on every /internal/* request (X-Internal-Key header).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me

# --- City config (used by the ingest and for "Today / Tomorrow / This weekend") ---
CITY_NAME=Tampa
STATE_CODE=FL
COUNTRY_CODE=US
CITY_TIMEZONE=America/New_York
