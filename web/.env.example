# Copy this file to web/.env.local and fill in real values. Never commit it.
# None of these use the NEXT_PUBLIC_ prefix on purpose: they stay on the server
# and never reach the browser.

# --- FastAPI ---
API_URL=http://localhost:8000

# Must be the same value as INTERNAL_API_KEY in api/.env.
INTERNAL_API_KEY=change-me

# --- Auth.js (Step 8) ---
# Generate with: npx auth secret
AUTH_SECRET=
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
